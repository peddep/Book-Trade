# Copy this file to .env.local and fill in your real values.

# Turso database connection (get these from the Turso dashboard / CLI)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Secret used to sign login session cookies. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Strongly recommended. Google Books now allows anonymous callers a daily
# quota of zero, so without a key every barcode scan and title lookup comes
# back empty and students have to type the publisher, tags and cover in by
# hand. Create a project at https://console.cloud.google.com, enable the
# "Books API" for it (enabling is the part that lifts the quota — a key alone
# does nothing), then create an API key and paste it here.
# GOOGLE_BOOKS_API_KEY=your-key-here

# Optional: which account sees the admin tools (Thai book import button on the
# profile page). If not set, the first account created (id 1) is the admin.
# ADMIN_EMAIL=you@example.com

# Optional: "Sign in with Google". Leave both unset to hide the button.
# Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add
# https://<your-domain>/api/auth/google/callback as an authorized redirect URI
# for every origin the app is served from.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
